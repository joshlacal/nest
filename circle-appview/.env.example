# Circle AppView Environment Configuration
# Copy to .env and configure for local development or E2E testing with scripts/e2e_circles.sh

# Network
CIRCLE_APPVIEW_HOST=0.0.0.0
CIRCLE_APPVIEW_PORT=3002

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/circle_appview

# Identity / resolution
SERVICE_DID=did:web:circles.catbird.blue#atproto_circle
PLC_DIRECTORY_URL=https://plc.directory
PUBLIC_APPVIEW_URL=https://public.api.bsky.app

# Required (no default) — AppView fails startup if unset
CIRCLE_MEDIA_BASE_URL=https://media.catbird.blue
NEST_CLIENT_ID=did:web:nest.catbird.blue
NEST_JWKS_URL=https://nest.catbird.blue/.well-known/jwks.json

# Logging
RUST_LOG=circle_appview=debug,tower_http=debug

# Push (AppView → Nest) Configuration
# AppView mints an ES256 service JWT to trigger generic circle_activity pushes
# on Nest. When any push variable below is set, the whole set must be complete
# or AppView fails startup (fail-closed). The signing key is provided either
# as a P-256 private key file (PUSH_SIGNING_KEY_PATH) or as raw hex bytes
# (PUSH_SIGNING_KEY_HEX); provide exactly one.
# NEST_PUSH_URL=https://nest.catbird.blue/internal/circle/push
# NEST_PUSH_AUDIENCE=https://api.catbird.blue
# NEST_PUSH_SERVICE_DID=did:web:push.catbird.blue
# PUSH_KEY_ID=did:web:circles.catbird.blue#atproto_circle
# PUSH_SIGNING_KEY_PATH=/path/to/p256_private.pem
# PUSH_SIGNING_KEY_HEX=0123456789abcdef...

# E2E Test Harness Configuration (for scripts/e2e_circles.sh)
# Disabled by default; configure with live Space-capable PDS endpoints, Nest sessions,
# server logs, push fixture, and Catbird public cache.
# SERVICE_DID must exactly match CIRCLE_APPVIEW_SERVICE_DID.
# DATABASE_URL must point at the actual Circle AppView PostgreSQL database.
# NEST_URL=http://127.0.0.1:3000
# CIRCLE_APPVIEW_URL=http://127.0.0.1:3002
# CIRCLE_APPVIEW_SERVICE_DID=did:web:circles.catbird.blue#atproto_circle
# PUBLIC_APPVIEW_URL=https://public.api.bsky.app
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/circle_appview
# ALICE_PDS_URL=http://127.0.0.1:3003
# ALICE_DID=did:plc:alice0000000000000000000
# ALICE_SESSION_ID=session_alice_uuid_or_cookie
# BOB_PDS_URL=http://127.0.0.1:3004
# BOB_DID=did:plc:bob0000000000000000000000
# BOB_SESSION_ID=session_bob_uuid_or_cookie
# CAROL_PDS_URL=http://127.0.0.1:3005
# CAROL_DID=did:plc:carol0000000000000000000
# CAROL_SESSION_ID=session_carol_uuid_or_cookie
# DAVE_PDS_URL=http://127.0.0.1:3006
# DAVE_DID=did:plc:dave00000000000000000000
# DAVE_SESSION_ID=session_dave_uuid_or_cookie
# NEST_LOG_PATH=/path/to/nest.log
# CIRCLE_APPVIEW_LOG_PATH=/path/to/circle_appview.log
# ALICE_PDS_LOG_PATH=/path/to/alice_pds.log
# BOB_PDS_LOG_PATH=/path/to/bob_pds.log
# CAROL_PDS_LOG_PATH=/path/to/carol_pds.log
# DAVE_PDS_LOG_PATH=/path/to/dave_pds.log
# PUSH_FIXTURE_PATH=/path/to/push_events.json
# CATBIRD_PUBLIC_CACHE_PATH=/path/to/catbird_public_cache.json
# ARTIFACTS_DIR=./artifacts/e2e_circles
