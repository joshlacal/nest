# /etc/catbird-backup/backup.env  (owner root, mode 0600)
#
# Configuration for catbird-backup.sh. Copy this file, fill in the
# placeholders, and keep the real values in the password manager as well:
# without RESTIC_PASSWORD and the bucket keys the backups cannot be read.
# Never commit the filled-in copy.

# ---- Where the backups go (Cloudflare R2, S3-compatible) -------------------
# One bucket for the whole fleet; each host writes under its own prefix.
# <ACCOUNT_ID> is the Cloudflare account ID shown on the R2 overview page.
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/catbird-backups/<HOST_NAME>/db
# R2 API token with "Object Read & Write" on the catbird-backups bucket only.
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=auto

# Encryption password for the repository. A file holding one random line:
#   openssl rand -base64 48 > /etc/catbird-backup/restic-password
RESTIC_PASSWORD_FILE=/etc/catbird-backup/restic-password

# Local cache for repository metadata (speeds up every run).
RESTIC_CACHE_DIR=/var/cache/catbird-backup

# ---- What to back up --------------------------------------------------------
# Name shown on snapshots. Keep it stable for the life of the host.
BACKUP_HOST_TAG=<HOST_NAME>
# Empty: every database in the local cluster except "postgres" and templates.
BACKUP_DATABASES=
# Databases to leave out of automatic discovery, space separated.
BACKUP_EXCLUDE_DATABASES=
# How to run the PostgreSQL client tools. Default: as the local postgres user.
# For PostgreSQL in Docker:
#   BACKUP_PG_EXEC=docker exec -i -u postgres <CONTAINER_NAME>
BACKUP_PG_EXEC=runuser -u postgres --
BACKUP_STAGING_DIR=/var/lib/catbird-backup/staging

# ---- Retention ---------------------------------------------------------------
# 7 daily + 4 weekly: the oldest snapshot is at most 22 days old. The privacy
# policy promises deleted data leaves backups within 30 days; keep the two in
# step if you change these.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=0

# ---- mls-ds recovery-share erasure journal (chat host only) ------------------
# Leave empty on hosts that do not run mls-ds with CHAT_CUTOVER_ENABLED.
# The directory that holds LABYRINTH_RECOVERY_SHARE_TOMBSTONE_FILE and its
# segment files. The service is stopped for a few seconds while it is copied.
BACKUP_JOURNAL_DIR=
BACKUP_JOURNAL_STOP_UNIT=catbird-mls-server
# A separate repository and password, readable by fewer people than the dumps.
JOURNAL_RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/catbird-backups/<HOST_NAME>/recovery-journal
JOURNAL_RESTIC_PASSWORD_FILE=/etc/catbird-backup/journal-restic-password

# ---- Alerting (optional) -----------------------------------------------------
# A dead-man's-switch check URL. Gets /start, success, or /fail.
BACKUP_HEALTHCHECK_URL=
