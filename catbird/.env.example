# Catbird Environment Variables
# Copy to .env and configure for local development

# Server Configuration
CATBIRD__SERVER__HOST=127.0.0.1
CATBIRD__SERVER__PORT=3000
CATBIRD__SERVER__ADMIN_PORT=9090
CATBIRD__SERVER__BASE_URL=http://localhost:3000
# CATBIRD__SERVER__ALLOWED_ORIGINS=https://catbird.blue,https://api.catbird.blue

# Redis Configuration
CATBIRD__REDIS__URL=redis://127.0.0.1:6379
# Key prefix for session storage (must contain explicit ':v2:' segment; custom tenant v2 prefixes supported)
# Startup fails if set to legacy 'catbird:session:' or any unversioned prefix.
CATBIRD__REDIS__KEY_PREFIX=catbird:v2:session:
CATBIRD__REDIS__SESSION_TTL_SECONDS=2592000

# Session Encryption Key (AES-256-GCM encryption and HMAC-SHA256 bearer key fingerprinting)
# Direct environment variable — NOT nested with CATBIRD__ prefix.
# Must be standard base64-encoded string of exactly 32 random bytes (44 base64 chars).
# Generate with: openssl rand -base64 32
# Note: Rotating this key changes HMAC session fingerprints and encryption, forcing re-authentication.
# SESSION_ENCRYPTION_KEY=

# OAuth Configuration
CATBIRD__OAUTH__CLIENT_ID=http://localhost:3000
CATBIRD__OAUTH__REDIRECT_URI=http://localhost:3000/auth/callback
# CATBIRD__OAUTH__PRIVATE_KEY_PATH=config/private_key.pem
# CATBIRD__OAUTH__PRIVATE_KEY_BASE64=

# Explicit initial scopes requested during initial sign-in.
# Initial sign-in retains core request for full-client compatibility.
# Chat needs no dedicated OAuth scope. Verified 2026-08-22 by live call against
# two PDS hosts: a session holding only the three scopes below mints
# com.atproto.server.getServiceAuth for aud=did:web:chat.catbird.blue#atproto_mls
# with HTTP 200. Account/identity permissions are never in the initial request.
CATBIRD__OAUTH__INITIAL_SCOPES=atproto,transition:generic,transition:chat.bsky

# Declared maximum scopes in client metadata (union of initial + optional JIT scopes).
# Progressive requests send explicit subsets during authorization/upgrade.
# Excluded by design: app-password management and account deletion scopes.
CATBIRD__OAUTH__MAX_SCOPES=atproto,transition:generic,transition:chat.bsky,identity:handle,account:email?action=manage,account:status?action=manage

# Legacy compatibility alias (backward-compatible initial input when initial_scopes
# absent; does not inherit optional max scopes)
# CATBIRD__OAUTH__SCOPES=atproto,transition:generic,transition:chat.bsky

# Push Database Configuration
# CATBIRD__PUSH__DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/catbird_push

# Push (APNs) Configuration
# When any push variable is set, the whole set must be complete or Nest fails startup.
# CATBIRD__PUSH__SERVICE_DID=did:web:push.catbird.blue
# CATBIRD__PUSH__APNS__KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# CATBIRD__PUSH__APNS__KEY_ID=XXXXXXXXXX
# CATBIRD__PUSH__APNS__TEAM_ID=XXXXXXXXXX
# CATBIRD__PUSH__APNS__TOPIC=blue.catbird
# CATBIRD__PUSH__APNS__PRODUCTION=true

# Chat / MLS v2 Standard AppView Configuration
# CATBIRD__CHAT__ENABLED=true
# CATBIRD__CHAT__EXTERNAL_BASE=https://chat.catbird.blue
# CATBIRD__CHAT__DS_INTERNAL_URL=http://127.0.0.1:3001
#
# nest no longer mints chat tokens: it forwards a service-auth JWT obtained from
# the user's own PDS, so mls-ds sees the user's DID as `iss`. The ISSUER /
# AUDIENCE / KEY_ID / SIGNING_KEY settings below are retained only as the
# rollback surface for that change and are read by no live code path.
# CATBIRD__CHAT__ISSUER=https://api.catbird.blue
# CATBIRD__CHAT__AUDIENCE=did:web:chat.catbird.blue

# Logging
RUST_LOG=catbird=debug,tower_http=debug

