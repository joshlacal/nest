# Catbird Environment Variables
# Copy to .env and configure for local development

# Server Configuration
CATBIRD__SERVER__HOST=127.0.0.1
CATBIRD__SERVER__PORT=3000
CATBIRD__SERVER__ADMIN_PORT=9090
CATBIRD__SERVER__BASE_URL=http://localhost:3000
# Empty denies all cross-origin browser access. Values must be exact canonical origins.
# CATBIRD__SERVER__ALLOWED_ORIGINS=https://catbird.blue,https://api.catbird.blue
# Only list exact socket-peer IPs of proxies that overwrite/append forwarding headers.
# CATBIRD__SERVER__TRUSTED_PROXY_IPS=127.0.0.1

# Redis Configuration
CATBIRD__REDIS__URL=redis://127.0.0.1:6379
CATBIRD__REDIS__KEY_PREFIX=catbird:session:
CATBIRD__REDIS__SESSION_TTL_SECONDS=2592000

# OAuth Configuration
CATBIRD__OAUTH__CLIENT_ID=http://localhost:3000
CATBIRD__OAUTH__REDIRECT_URI=http://localhost:3000/auth/callback
# CATBIRD__OAUTH__PRIVATE_KEY_PATH=config/private_key.pem
# CATBIRD__OAUTH__PRIVATE_KEY_BASE64=

# OAuth Session Protection
# Required for an OAuth-capable run. Each value must be the base64 encoding of
# exactly 32 random bytes, and the two decoded keys must be distinct. Values are
# intentionally omitted; provision them outside source control.
# SESSION_ENCRYPTION_KEY=
# SESSION_IDENTIFIER_HMAC_KEY=
# Optional rotation metadata; previous keys use comma-separated kid=base64 entries.
# SESSION_ENCRYPTION_KEY_ID=
# SESSION_ENCRYPTION_PREVIOUS_KEYS=

# Conditional Direct MLS Routing
# Direct routing is enabled only when SERVICE_URL and GATEWAY_DID are configured.
# PROOF_ORIGIN must be an exact HTTPS origin. The downstream MLS service remains
# responsible for delegated JWT/DPoP validation and authorization.
# CATBIRD__MLS__SERVICE_URL=
# CATBIRD__MLS__GATEWAY_DID=
# CATBIRD__MLS__PROOF_ORIGIN=
# CATBIRD__MLS__SERVICE_DID=

# Optional Push Control Plane
# Push services are enabled only when DATABASE_URL and SERVICE_DID are configured.
# CATBIRD__PUSH__DATABASE_URL=
# CATBIRD__PUSH__SERVICE_DID=
# CATBIRD__PUSH__CHAT_POLL_ENABLED=false
# CATBIRD__PUSH__APNS__KEY_PATH=
# CATBIRD__PUSH__APNS__KEY_ID=
# CATBIRD__PUSH__APNS__TEAM_ID=
# CATBIRD__PUSH__APNS__TOPIC=
# CATBIRD__PUSH__APNS__PRODUCTION=false

# Logging
RUST_LOG=catbird=debug,tower_http=debug
