# Catbird Environment Variables
# Copy to .env and configure for local development

# Server Configuration
CATBIRD__SERVER__HOST=127.0.0.1
CATBIRD__SERVER__PORT=3000
CATBIRD__SERVER__ADMIN_PORT=9090
CATBIRD__SERVER__BASE_URL=http://localhost:3000
# CATBIRD__SERVER__ALLOWED_ORIGINS=https://catbird.blue,https://api.catbird.blue

# Redis Configuration
CATBIRD__REDIS__URL=redis://127.0.0.1:6379
CATBIRD__REDIS__KEY_PREFIX=catbird:session:
CATBIRD__REDIS__SESSION_TTL_SECONDS=2592000

# OAuth Configuration
CATBIRD__OAUTH__CLIENT_ID=http://localhost:3000
CATBIRD__OAUTH__REDIRECT_URI=http://localhost:3000/auth/callback
# CATBIRD__OAUTH__PRIVATE_KEY_PATH=config/private_key.pem
# CATBIRD__OAUTH__PRIVATE_KEY_BASE64=

# Circle OAuth scopes are explicit grants, not part of the legacy fallback.
CATBIRD__OAUTH__SCOPES=atproto,transition:generic,transition:chat.bsky,space:blue.catbird.circle?authority=*&action=read&action=create&action=update&action=delete&collection=app.bsky.feed.post&collection=app.bsky.feed.like,space:blue.catbird.circle?authority=self&action=create&action=update&action=delete&manage=create&manage=update&manage=delete&collection=blue.catbird.circle.metadata

# Chat / MLS v2 Standard AppView Configuration
# CATBIRD__CHAT__ENABLED=true
# CATBIRD__CHAT__EXTERNAL_BASE=https://chat.catbird.blue
# CATBIRD__CHAT__DS_INTERNAL_URL=http://127.0.0.1:3001
#
# nest no longer mints chat tokens: it forwards a service-auth JWT obtained from
# the user's own PDS, so mls-ds sees the user's DID as `iss`. The ISSUER /
# AUDIENCE / KEY_ID / SIGNING_KEY settings below are retained only as the
# rollback surface for that change and are read by no live code path.
# CATBIRD__CHAT__ISSUER=https://api.catbird.blue
# CATBIRD__CHAT__AUDIENCE=did:web:chat.catbird.blue

# Logging
RUST_LOG=catbird=debug,tower_http=debug
