# Catbird Environment Variables
# Copy to .env and configure for local development

# Server Configuration
CATBIRD__SERVER__HOST=127.0.0.1
CATBIRD__SERVER__PORT=3000
CATBIRD__SERVER__ADMIN_PORT=9090
CATBIRD__SERVER__BASE_URL=http://localhost:3000
# CATBIRD__SERVER__ALLOWED_ORIGINS=https://catbird.blue,https://api.catbird.blue

# Redis Configuration
CATBIRD__REDIS__URL=redis://127.0.0.1:6379
CATBIRD__REDIS__KEY_PREFIX=catbird:session:
CATBIRD__REDIS__SESSION_TTL_SECONDS=2592000

# OAuth Configuration
CATBIRD__OAUTH__CLIENT_ID=http://localhost:3000
CATBIRD__OAUTH__REDIRECT_URI=http://localhost:3000/auth/callback
# CATBIRD__OAUTH__PRIVATE_KEY_PATH=config/private_key.pem
# CATBIRD__OAUTH__PRIVATE_KEY_BASE64=

# Circle OAuth scopes are explicit grants, not part of the legacy fallback.
CATBIRD__OAUTH__SCOPES=atproto,transition:generic,transition:chat.bsky,space:blue.catbird.circle?authority=*&action=read&action=create&action=update&action=delete&collection=app.bsky.feed.post&collection=app.bsky.feed.like,space:blue.catbird.circle?authority=self&action=create&action=update&action=delete&manage=create&manage=update&manage=delete&collection=blue.catbird.circle.metadata

# Circle Configuration (disabled by default)
# When CATBIRD__CIRCLE__SERVICE_URL is set, Circle capability is enabled and Nest
# requires PostgreSQL (CATBIRD__PUSH__DATABASE_URL) for durable projection outbox and retry worker.
# Leave unset or empty to keep Circles disabled by default.
# Release harness values must exactly match CIRCLE_APPVIEW_URL and CIRCLE_APPVIEW_SERVICE_DID.
# CATBIRD__CIRCLE__SERVICE_URL=http://127.0.0.1:3002
# CATBIRD__CIRCLE__SERVICE_DID=did:web:circles.catbird.blue#atproto_circle
# CATBIRD__CIRCLE__PLC_DIRECTORY_URL=https://plc.directory

# Push / Outbox Database Configuration (required when Circle capability is enabled)
# CATBIRD__PUSH__DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/catbird_push

# Push (Circle AppView → Nest) Configuration
# Enables the internal push endpoint that Circle AppView uses to trigger
# generic `circle_activity` APNs notifications. When any push variable is set,
# the whole set must be complete or Nest fails startup.
# CATBIRD__PUSH__SERVICE_DID=did:web:push.catbird.blue
# CATBIRD__PUSH__APNS__KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# CATBIRD__PUSH__APNS__KEY_ID=XXXXXXXXXX
# CATBIRD__PUSH__APNS__TEAM_ID=XXXXXXXXXX
# CATBIRD__PUSH__APNS__TOPIC=blue.catbird
# CATBIRD__PUSH__APNS__PRODUCTION=true

# Logging
RUST_LOG=catbird=debug,tower_http=debug

# E2E Test Harness Configuration (for scripts/e2e_circles.sh)
# Disabled by default; configure with live Space-capable PDS endpoints, Nest sessions,
# Circle AppView database, server log paths, push fixture, and Catbird public cache.
# Sessions require atproto + the two pinned Circle Space scopes and PDS getServiceAuth support.
# NEST_URL=http://127.0.0.1:3000
# CIRCLE_APPVIEW_URL=http://127.0.0.1:3002
# CIRCLE_APPVIEW_SERVICE_DID=did:web:circles.catbird.blue#atproto_circle
# PUBLIC_APPVIEW_URL=https://public.api.bsky.app
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/circle_appview
# ALICE_PDS_URL=http://127.0.0.1:3003
# ALICE_DID=did:plc:alice0000000000000000000
# ALICE_SESSION_ID=session_alice_uuid_or_cookie
# BOB_PDS_URL=http://127.0.0.1:3004
# BOB_DID=did:plc:bob0000000000000000000000
# BOB_SESSION_ID=session_bob_uuid_or_cookie
# CAROL_PDS_URL=http://127.0.0.1:3005
# CAROL_DID=did:plc:carol0000000000000000000
# CAROL_SESSION_ID=session_carol_uuid_or_cookie
# DAVE_PDS_URL=http://127.0.0.1:3006
# DAVE_DID=did:plc:dave00000000000000000000
# DAVE_SESSION_ID=session_dave_uuid_or_cookie
# NEST_LOG_PATH=/path/to/nest.log
# CIRCLE_APPVIEW_LOG_PATH=/path/to/circle_appview.log
# ALICE_PDS_LOG_PATH=/path/to/alice_pds.log
# BOB_PDS_LOG_PATH=/path/to/bob_pds.log
# CAROL_PDS_LOG_PATH=/path/to/carol_pds.log
# DAVE_PDS_LOG_PATH=/path/to/dave_pds.log
# PUSH_FIXTURE_PATH=/path/to/push_events.json
# CATBIRD_PUBLIC_CACHE_PATH=/path/to/catbird_public_cache.json
# ARTIFACTS_DIR=./artifacts/e2e_circles
